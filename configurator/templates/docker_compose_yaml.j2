# =================================================================
# Generated by configurator/collection_mapping.py — do not edit by hand,
# change configurator/csw_endpoints.yml and regenerate instead.
#
# Deploy with `sh update_service.sh {{ data.name }}`: it exports REPO_DIR and loads
# the Solr credentials from .env, which this file only references.
# =================================================================
{% set name = data.name %}
{% set docker = data.docker %}
{% set auth = data.repository.auth | default(true) %}
{% set repo_dir = '${REPO_DIR?Variable not set}' %}
{% set outputschemas_dir = docker.outputschemas_dir | default('/home/pycsw/pycsw/pycsw/plugins/outputschemas') %}
{% set reservations = docker.reservations | default({}) %}
{% set secure_headers = docker.secure_headers | default(true) %}
{% set traefik = docker.expose == 'traefik' %}

version: '3.8'

services:
  pycsw:
    image: {{ docker.image }}{% if docker.image_tag is defined and docker.image_tag %}:{{ docker.image_tag }}{% endif %}

    environment:
      - METNO_PYCSW_COLLECTIONS_LIMIT={{ docker.collections_limit | default(1) }}
{% if auth %}
      # Expanded by pycsw from ${...} references in pycsw.yml
      - {{ data.repository.username_env | default('SOLR_USER') }}=${{ '{' }}{{ data.repository.username_env | default('SOLR_USER') }}?Variable not set}
      - {{ data.repository.password_env | default('SOLR_PASS') }}=${{ '{' }}{{ data.repository.password_env | default('SOLR_PASS') }}?Variable not set}
{% endif %}
    volumes:
      - ./pycsw.yml:/etc/pycsw/pycsw.yml
      - ./pycsw.log:/tmp/pycsw.log
      # Hot-patch the installed plugin package — edits to pycsw_solr_metno/*.py
      # are seen on the next pycsw process restart (no rebuild needed).
      - {{ docker.plugin_dir | default(repo_dir ~ '/pycsw_solr_metno') }}:/venv/lib/python3.12/site-packages/pycsw_solr_metno
      - {{ repo_dir }}/mmd/xslt/:/usr/local/share/mmd/xslt/
      - {{ repo_dir }}/mmd/thesauri/:/usr/local/share/mmd/thesauri/
      # MET Norway outputschemas, over the pycsw source tree the server imports
      # from (gunicorn runs in /home/pycsw/pycsw, which shadows site-packages).
      # atom / fgdc / gm03 / datacite come from the image.
{% for schema in ['__init__', 'dif', 'dif10', 'wmo'] %}
      - {{ repo_dir }}/outputschemas/{{ schema }}.py:{{ outputschemas_dir }}/{{ schema }}.py
{% endfor %}
      - /usr/local/share/csw/parent_list.xml:/usr/local/share/csw/parent_list.xml
{% if not traefik %}
    # No Traefik: published on every swarm node, served at {{ data.server.server_url }}
    ports:
      - target: 8000
        published: {{ docker.port }}
        protocol: tcp
{% endif %}
    networks:
      - net
{% if traefik %}
      - traefik-public
{% endif %}
    deploy:
{% if reservations is not false %}
      resources:
        reservations:
          cpus: '{{ reservations.cpus | default('0.5') }}'
          memory: {{ reservations.memory | default('1024M') }}
{% endif %}
      placement:
        constraints:
          - node.role == manager
{% if traefik %}
      labels:
        - traefik.enable=true
        - traefik.swarm.network=traefik-public
        - traefik.constraint-label=traefik-public
        - traefik.http.routers.{{ name }}-http.rule=Host(`{{ docker.domain }}`)
        - traefik.http.routers.{{ name }}-http.entrypoints=http
        - traefik.http.routers.{{ name }}-http.middlewares=https-redirect
        - traefik.http.routers.{{ name }}-https.rule=Host(`{{ docker.domain }}`)
        - traefik.http.routers.{{ name }}-https.entrypoints=https
        - traefik.http.routers.{{ name }}-https.tls=true
        - traefik.http.routers.{{ name }}-https.tls.certresolver=le
        - traefik.http.services.{{ name }}.loadbalancer.server.port=8000
{% if secure_headers %}
        # Secure Headers Middleware
        - "traefik.http.middlewares.{{ name }}-secure-headers.headers.frameDeny=true"
        - "traefik.http.middlewares.{{ name }}-secure-headers.headers.browserXssFilter=true"
        - "traefik.http.middlewares.{{ name }}-secure-headers.headers.contentTypeNosniff=true"
        - "traefik.http.middlewares.{{ name }}-secure-headers.headers.stsIncludeSubdomains=true"
        - "traefik.http.middlewares.{{ name }}-secure-headers.headers.stsPreload=true"
        - "traefik.http.middlewares.{{ name }}-secure-headers.headers.stsSeconds=31536000"
{% endif %}
        # allow CORS
        - "traefik.http.middlewares.{{ name }}-cors.headers.accesscontrolallowmethods=GET,OPTIONS,PUT"
        - "traefik.http.middlewares.{{ name }}-cors.headers.accesscontrolalloworiginlist=*"
        - "traefik.http.middlewares.{{ name }}-cors.headers.accesscontrolmaxage=100"
        - "traefik.http.middlewares.{{ name }}-cors.headers.addvaryheader=true"
        - "traefik.http.routers.{{ name }}-https.middlewares={% if secure_headers %}{{ name }}-secure-headers,{% endif %}{{ name }}-cors"
        # rewrite and redirect rules
        #- "traefik.http.middlewares.{{ name }}-opensearch-results-redirectregex.redirectregex.regex=^https:\/\/{{ name }}\.csw\.met\.no\/opensearch\?$"
        #- "traefik.http.middlewares.{{ name }}-opensearch-results-redirectregex.redirectregex.replacement=https://{{ name }}.csw.met.no/csw?mode=opensearch&"
        #- "traefik.http.middlewares.{{ name }}-opensearch-redirectregex.redirectregex.regex=^https:\/\/{{ name }}\.csw\.met\.no\/opensearch$"
        #- "traefik.http.middlewares.{{ name }}-opensearch-redirectregex.redirectregex.replacement=https://{{ name }}.csw.met.no/csw?mode=opensearch&service=CSW&version=3.0.0&request=GetCapabilities"
        #- "traefik.http.middlewares.{{ name }}-oaipmh-results-redirectregex.redirectregex.regex=^https:\/\/{{ name }}\.csw\.met\.no\/oaipmh\?$"
        #- "traefik.http.middlewares.{{ name }}-oaipmh-results-redirectregex.redirectregex.replacement=https://{{ name }}.csw.met.no/csw?mode=oaipmh&"
        #- "traefik.http.middlewares.{{ name }}-oipmh-redirectregex.redirectregex.regex=^https:\/\/{{ name }}\.csw\.met\.no\/oaipmh$"
        #- "traefik.http.middlewares.{{ name }}-oaipmh-redirectregex.redirectregex.replacement=https://{{ name }}.csw.met.no/csw?mode=oaipmh&verb=Identify"
        #- "traefik.http.routers.{{ name }}-https.middlewares={{ name }}-opensearch-results-redirectregex,{{ name }}-opensearch-redirectregex,{{ name }}-oaipmh-results-redirectregex,{{ name }}-oaipmh-redirectregex"
{% endif %}

networks:
  net:
    driver: overlay
    attachable: true
{% if traefik %}
  traefik-public:
    external: true
{% endif %}
