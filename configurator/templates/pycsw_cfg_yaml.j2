# =================================================================
# Generated by configurator/collection_mapping.py — do not edit by hand,
# change configurator/csw_endpoints.yml and regenerate instead.
#
# ${VAR} references are expanded by pycsw from the container environment.
# =================================================================
{% set inspire = data.metadata_inspire | default({}) %}

server:
    url: {{ data.server.server_url }}
    mimetype: application/xml; charset=UTF-8
    encoding: UTF-8
    language: en-US
    maxrecords: {{ data.server.maxrecords | default(10) }}
    pretty_print: true
    gzip_compresslevel: 9
{% if data.server.workers is defined %}
    workers: {{ data.server.workers }}
{% endif %}
{% if data.server.timeout is defined %}
    timeout: {{ data.server.timeout }}
{% endif %}

logging:
    level: {{ data.logging_level | default('DEBUG') }}

profiles:
    - apiso

federatedcatalogues:
    - http://catalog.data.gov/csw

manager:
    transactions: false
    allowed_ips:
        - 127.0.0.1
    csw_harvest_pagesize: 10

metadata:
    identification:
        title: {{ data.metadata.identification_title }}
        description: "pycsw is an OARec and OGC CSW server implementation written in Python"
        keywords:
            - catalogue
            - discovery
            - metadata
        keywords_type: theme
        fees: None
        accessconstraints: None
        terms_of_service: https://creativecommons.org/licenses/by/4.0
        url: {{ data.metadata.provider_url }}
    license:
        name: CC-BY 4.0 license
        url: https://creativecommons.org/licenses/by/4.0
    provider:
        name: {{ data.metadata.provider_name | default('') }}
        url: {{ data.metadata.provider_url }}
    contact:
        name: {{ data.metadata.contact_name }}
        position: {{ data.metadata.contact_position | default('') }}
        address: Mailing Address
        city: City
        stateorprovince: Administrative Area
        postalcode: Zip or Postal Code
        country: Country
        phone: +xx-xxx-xxx-xxxx
        fax: +xx-xxx-xxx-xxxx
        email: {{ data.metadata.contact_email }}
        url: {{ data.metadata.contact_url }}
        hours: Mo-Fr 08:00-17:00
        instructions: During hours of service. Off on weekends.
        role: pointOfContact
    inspire:
        enabled: true
        languages_supported:
            - eng
        default_language: eng
        date: {{ inspire.date | default('YYYY-MM-DD') }}
        gemet_keywords:
            - Utility and governmental services
        conformity_service: notEvaluated
        contact_name: {{ inspire.contact_name | default(data.metadata.contact_name) }}
        contact_email: {{ inspire.contact_email | default(data.metadata.contact_email) }}
        temp_extent:
            begin: {{ inspire.temp_extent.split('/') [0] if inspire.temp_extent is defined else 'YYYY-MM-DD' }}
            end: {{ inspire.temp_extent.split('/') [1] if inspire.temp_extent is defined else 'YYYY-MM-DD' }}

repository:
    database: null
    source: pycsw_solr_metno.solr_metno.SolrMETNORepository
    filter: {{ data.repository.filter }}
{% if data.repository.auth | default(true) %}
    # Solr credentials come from the environment (.env), never from this file
    username: ${{ '{' }}{{ data.repository.username_env | default('SOLR_USER') }}}
    password: ${{ '{' }}{{ data.repository.password_env | default('SOLR_PASS') }}}
{% endif %}

    # Set custom user-agent string per service
    user_agent_string: {{ data.repository.user_agent | default('"PyCSW SolrMETNORepository/4.0"') }}

    # MMD ISO XSLT PATH
    mmd_to_iso_xslt_path: {{ data.repository.mmd_to_iso_xslt_path | default('') }}
    # Parent list xml path
    parent_list_path: {{ data.repository.parent_list_path | default("''") }}

    adc_collections:
{% for collection in data.repository.collections.split(',') %}
      - {{ collection | trim }}
{% endfor %}
    # query_mappings / solr_mappings / facets are data-driven: define them per
    # endpoint under `repository:` in csw_endpoints.yml to override the defaults below.
{% set default_query_mappings = {
    'title': 'title_en',
    'date': 'temporal_extent_start_date',
} %}
{% set query_mappings = data.repository.query_mappings | default(default_query_mappings, true) %}
    query_mappings:
{% for key, value in query_mappings.items() %}
        {{ key }}: {{ value }}
{% endfor %}
{% set default_solr_mappings = {
    'identifier': 'metadata_identifier',
    'title': 'title',
    'updated': 'timestamp',
    'dc:title': 'title',
    'abstract': 'abstract',
    'csw:AnyText': 'full_text',
    'ows:BoundingBox': 'geospatial_bounds3d',
    'geometry': 'geospatial_bounds3d',
    'parentidentifier': 'related_dataset',
    'anytext': 'full_text',
    'pycsw:TempExtent_begin': 'temporal_extent_start_date',
    'pycsw:TempExtent_end': 'temporal_extent_end_date',
    'apiso:TempExtent_begin': 'temporal_extent_start_date',
    'apiso:TempExtent_end': 'temporal_extent_end_date',
    'time_begin': 'temporal_extent_start_date',
    'time_end': 'temporal_extent_end_date',
    'activity_type': 'activity_type',
    'cloudcover': 'platform_ancillary_cloud_coverage',
    'platform': 'platform_long_name',
    'instrument': 'platform_instrument_short_name',
    'collection': 'related_dataset',
    'collections': 'related_dataset',
    'type': 'isChild',
    'iso_topic_category': 'iso_topic_category',
    'datetime': 'temporal_extent_period_dr',
} %}
{% set solr_mappings = data.repository.solr_mappings | default(default_solr_mappings, true) %}
    solr_mappings:
{% for key, value in solr_mappings.items() %}
        {{ key }}: {{ value }}
{% endfor %}
{% set default_facets = ['activity_type', 'iso_topic_category', 'platform_instrument_product_type', 'platform'] %}
{% set facets = data.repository.facets | default(default_facets, true) %}
    facets:
{% for facet in facets %}
      - {{ facet }}
{% endfor %}
