# Copy to .env (gitignored) and fill in. Single-quote values containing shell
# special characters. Loaded by host_setup.sh and update_service.sh.

# --- Solr credentials -------------------------------------------------------
# Forwarded to the pycsw containers by the generated stack files and referenced
# from the generated pycsw.yml as ${SOLR_USER} / ${SOLR_PASS}.
# Also read by tests/build_fixtures.py and fetch_collections.py.
SOLR_USER=
SOLR_PASS=''

# --- Host setup (host_setup.sh) ---------------------------------------------
# Contact address for the Let's Encrypt certificates requested by Traefik.
ACME_EMAIL=
# Solr core listing the parent datasets, used to build
# /usr/local/share/csw/parent_list.xml (fetch_collections.py).
# PARENT_LIST_SOLR_URL=https://solr.example.org/solr/core
# Only with several network interfaces: address for `docker swarm init`.
# SWARM_ADVERTISE_ADDR=

# --- Only needed by tests/build_fixtures.py ----------------------------------
# SOLR_URL=https://solr.example.org/solr/core
